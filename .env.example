# Copie para .env e ajuste: cp .env.example .env
# O .env real nunca vai para o Git (veja o .gitignore).
# Os valores abaixo batem com o infra/docker-compose.yml e com os scripts de init.
# São senhas de demonstração: troque todas fora do seu computador.

# Origem: de onde o Airbyte lê e onde o gerador de dados escreve.
ORIGEM_URL=postgresql://origem:origem123@localhost:5433/origem_seguradoras

# Warehouse local (bronze/silver/gold).
DW_URL=postgresql://warehouse:warehouse123@localhost:5434/dw_medalhao

# Usuários com permissões separadas por responsabilidade:
#   airbyte_user: só escreve na bronze
#   dbt_user:     lê a bronze, escreve na silver e na gold
DW_AIRBYTE_URL=postgresql://airbyte_user:airbyte123@localhost:5434/dw_medalhao
DW_DBT_URL=postgresql://dbt_user:dbt123@localhost:5434/dw_medalhao

# O Dagster deriva a conexão do dbt a partir desta variável. Use o usuário do
# dbt, nunca o da origem.
WAREHOUSE_URL=postgresql://dbt_user:dbt123@localhost:5434/dw_medalhao

# Airbyte (abctl local credentials mostra o client id e o secret)
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CONNECTION_ID=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
